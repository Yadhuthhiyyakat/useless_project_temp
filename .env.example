Frontend
# Digital Cemetery Frontend Configuration
# Copy this file to .env.local and customize

# Backend API base URL (must match backend CORS_ORIGINS)
VITE_API_BASE_URL=http://localhost:8000/api/v1

Backend

DATABASE_URL=sqlite:///./data/cemetery.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AI_EPITAPHS_ENABLED=false
LOG_LEVEL=INFO
WATCHED_DIRECTORIES=Path of directory
